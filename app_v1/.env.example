ODPT_API_KEY=
ODPT_CHL_API_KEY=
DEBUG_MODE=false
ENABLED_ROUTES=FastestRoutes
# 共有されたときの見え方（#126）。og:image と og:url は絶対 URL でないと読まれない。
# 未設定なら https://team301.jp。手元で確かめるときや公開先が変わったときに使う
SITE_ORIGIN=
# 「間に合わなかった」などの報告の送り先（#122）。未設定なら apidata/reports/ に保存する
REPORT_FORM_ACTION=
REPORT_FORM_ENTRIES=
# リバースプロキシの後ろで動かすとき（報告の連投制限を送信元ごとに数えるため）。例: loopback
TRUST_PROXY=
# 報告の欄を出すか（#122）。false にして再起動すると、ボタン・一文・報告の欄を消し、受け口も止める
REPORT_ENABLED=false
# 仮データでの表示（app_v1/demo/）。off＝使わない、fallback＝実データが取れないときだけ仮データ、always＝いつも仮データ。
# 未設定なら off（公開用のコピーは fallback）。仮データは作り物で、実際の時刻・運行ではない
DEMO_MODE=
