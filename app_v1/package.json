{
  "name": "hamakoku-app",
  "version": "1.0.0",
  "description": "横浜国立大学から横浜駅への乗換案内（はまこく Exp.）と、構内のシェアサイクルの地図（はまこく Map）",
  "main": "app.js",
  "type": "module",
  "scripts": {
